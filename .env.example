# Skopiuj do .env.local (lokalnie) i uzupełnij te same nazwy w Vercel →
# Project Settings → Environment Variables (produkcja).

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz service_role — omija RLS. Tylko po stronie serwera, NIGDY w kliencie.
SUPABASE_SERVICE_ROLE_KEY=

# Sekret Send Email Hook (Authentication → Hooks → Send Email hook w panelu
# Supabase, przycisk „Generate Secret”). Wartość ma postać "v1,whsec_<base64>",
# wklej ją całą, wraz z prefiksem. Bez tego endpoint
# /api/auth/send-email-hook odrzuci każde wywołanie Supabase (błąd 401) —
# a dopóki hook nie jest podłączony w panelu, Supabase w ogóle go nie wywoła
# i dalej wysyła własne, niebrandowane maile.
SEND_EMAIL_HOOK_SECRET=

# ── Adres aplikacji ──────────────────────────────────────────────────────
# Bez protokołu-rozjazdu: musi być identyczny z Site URL i wpisem na liście
# Redirect URLs w Supabase (Authentication → URL Configuration), inaczej
# linki resetu hasła i zaproszeń lądują na złej domenie.
NEXT_PUBLIC_APP_URL=https://unick-academy.pl

# ── Poczta (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
# Adresy powiadomień wewnętrznych (kilka po przecinku, opcjonalnie)
SCHOOL_NOTIFY_EMAIL=hello@unick-academy.pl
SCHOOL_NOTIFY_PHONE=
FOUNDATION_NOTIFY_EMAIL=

# ── SMS (SMSAPI) ─────────────────────────────────────────────────────────
SMSAPI_TOKEN=

# ── WhatsApp (przez Make/Zapier — dowolny mostek nasłuchujący webhook) ───
WHATSAPP_WEBHOOK_URL=
ZAPIER_WHATSAPP_WEBHOOK_URL=

# ── Stripe ───────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cron (Vercel Cron → nagłówek Authorization: Bearer <ten sekret>) ─────
CRON_SECRET=

# ── GUS / dane firm (weryfikacja NIP) ────────────────────────────────────
GUS_API_URL=
GUS_API_KEY=

# ── GoCardless (bankowość, uFOS) ─────────────────────────────────────────
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# ── Claude / Anthropic (AI-CFO w uFOS) ───────────────────────────────────
ANTHROPIC_API_KEY=
